<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".DetallePelicula">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_imagenPelicula"
            android:layout_width="113dp"
            android:layout_height="85dp"
            android:layout_gravity="center"
            android:src="@drawable/bones" />

        <TextView
            android:id="@+id/tv_nombrePelicula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BONES"
            android:textSize="15sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_descripcionPelicula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Proin sem tortor, luctus vel enim id, tincidunt convallis lorem. Duis venenatis feugiat tortor vel accumsan. Aliquam erat volutpat."
            android:textSize="20sp" />


    </LinearLayout>


</LinearLayout>